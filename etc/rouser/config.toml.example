# rouser configuration file
# Default location: /etc/rouser/config.toml
# Set RUST_LOG=debug for debug logging, RUST_LOG=info for info

name = "rouser"
update_interval = "3s"
log_level = "debug"

[thresholds]
cpu_usage = 10.0
gpu_usage = 15.0
network_io = 5.0
disk_activity = 1.0

[timing]
duration_threshold = "10s"
idle_duration = "120s"

[inhibition]
what = "sleep"
mode = "block-weak"

[network]
exclude_interfaces = ["lo"]
include_interfaces = []

[disk]
exclude_device_prefixes = ["loop", "fd", "sr", "cdrom"]
