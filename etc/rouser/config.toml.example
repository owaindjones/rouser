# rouser configuration file
# Default location: /etc/rouser/config.toml
# Set RUST_LOG=debug for debug logging, RUST_LOG=info for info

name = "rouser"
update_interval = "5s"
log_level = "debug"

[thresholds]
cpu_usage = 80.0
gpu_usage = 90.0
network_io = 100.0
disk_activity = 50.0

[timing]
duration_threshold = "30s"
idle_duration = "60s"

[inhibition]
what = ["sleep", "hibernate", "shutdown"]
mode = "block"

[network]
exclude_interfaces = ["lo"]
include_interfaces = []

[disk]
exclude_device_prefixes = ["loop", "fd", "sr", "cdrom"]
