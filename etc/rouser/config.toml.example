# rouser configuration file
# Default location: /etc/rouser/config.toml
# Set RUST_LOG=debug for debug logging, RUST_LOG=info for info

name = "rouser"
update_interval = "3s"
log_level = "debug"

# Per-metric configuration with thresholds and EMA smoothing parameters
[metrics.cpu]
threshold = 10.0      # CPU usage threshold (percentage)
ema_alpha = 0.3       # EMA smoothing factor (0.0-1.0, higher = more responsive)

[metrics.gpu]
threshold = 15.0      # GPU usage threshold (percentage)
ema_alpha = 0.3       # EMA smoothing factor

[metrics.network]
threshold = 5.0       # Network I/O threshold (Mbps)
ema_alpha = 0.2       # EMA smoothing factor (lower for network to avoid spikes)
exclude_interfaces = ["lo"]
include_interfaces = []

[metrics.disk]
threshold = 1.0       # Disk I/O threshold (MB/s)
ema_alpha = 0.2       # EMA smoothing factor
exclude_device_prefixes = ["loop", "fd", "sr", "cdrom"]

# Timing configuration
[timing]
duration_threshold = "10s"    # Min time above threshold before inhibiting sleep
cooldown_duration = "60s"     # Time below threshold before releasing inhibition

[inhibition]
what = "idle"    # Lock type: idle, sleep, suspend, shutdown
mode = "block-weak"  # Mode: block, delay, block-weak
