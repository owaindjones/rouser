 # rouser configuration file
# Default location: /etc/rouser/config.toml
# Set RUST_LOG=debug for debug logging, RUST_LOG=info for info, etc.

name = "rouser"
update_interval = "5s"  # Polling interval
log_level = "info"

# Metric thresholds (percentages and MB/s)
[thresholds]
cpu_usage = 10.0      # CPU usage percentage
gpu_usage = 15.0      # GPU usage percentage
network_io = 5.0    # Network throughput in Mbps
disk_activity = 1.0  # Disk throughput in MB/s

# Timing parameters
[timing]
duration_threshold = "30s"  # Time above threshold before inhibiting
idle_duration = "60s"       # Time below threshold before releasing

# D-Bus inhibition settings
[inhibition]
what = ["idle", "sleep", "hibernate", "shutdown"]
mode = "block-weak"

# Network interface configuration
[network]
exclude_interfaces = ["lo"]  # Exclude loopback interface
include_interfaces = []      # Include only these (empty = all except excluded)

# Disk device configuration
[disk]
exclude_device_prefixes = ["loop", "fd", "sr", "cdrom"]
# Note: dm- (LVM) devices are included by default
